{
    "mcpServers": {
        "ai_chat_lib": {
            "timeout": 60,
            "type": "stdio",
            "command": "uv",
            "args": [
                "--directory",
                "<PATH_TO_VENV>",
                "run",
                "-m",
                "ai_chat_lib.mcp_modules.mcp_app_server"
            ],
            "env": {
                "OPENAI_API_KEY": "sk-****",
                "AZURE_OPENAI": "false",
                "OPENAI_COMPLETION_MODEL": "gpt-4.1",
                "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small",
                "APP_DATA_PATH": "<PATH_TO_APP_DATA>",
                "PLAYWRIGHT_HEADLESS": "false",
                "PLAYWRIGHT_BROWSER": "msedge",
                "PLAYWRIGHT_AUTH_JSON": "<PATH_TO_PLAYWRIGHT_AUTH_JSON>",
                "MCP_TOOLS": "search_wikipedia_ja_mcp,vector_search_mcp,get_vector_folder_paths_mcp,extract_file_mcp,web_search_mcp,extract_webpage,ddgs_search,extract_text_from_file_mcp,download_file_mcp,analyze_image_mcp,analyze_two_images_mcp"            
            }
        }
    }
}